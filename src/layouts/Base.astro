---
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/400-italic.css';
import '@fontsource/open-sans/700.css';
import '@fontsource/italianno/400.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  solidHeader?: boolean; // pagina's zonder grote kopfoto
}
const { title, description = 'Kultuurfabriek Kooiaap organiseert op een fraaie locatie op het Friese platteland regelmatig concerten van aan country en folk gerelateerde artiesten.', solidHeader = false } = Astro.props;
const siteName = 'Kultuurfabriek Kooi-Aap';
const fullTitle = title ? `${title} | ${siteName}` : siteName;

const menu = [
  ['Home', '/'],
  ['Over ons', '/over-ons/'],
  ['Nieuws', '/nieuws/'],
  ['Agenda', '/verwachte-artiesten/'],
  ['Locatie & Route', '/locatie-route/'],
  ['Contact', '/contact/'],
];
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length);
const isActive = (href: string) => (href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(href));
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href={logo.src} />
    <link rel="apple-touch-icon" href={logo.src} />
  </head>
  <body>
    <header class:list={['site-header', { solid: solidHeader }]}>
      <div class="header-inner">
        <a href={url('/')} class="logo" aria-label={`${siteName} – home`}>
          <Image src={logo} alt="" height={60} densities={[1, 2]} loading="eager" />
        </a>
        <button class="menu-toggle" popovertarget="menu" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="menu" popover aria-label="Hoofdmenu">
          <ul>
            {menu.map(([label, href]) => (
              <li><a href={url(href)} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          © {new Date().getFullYear()} {siteName} · Leijester Hegedijk 27 B, 9071 XB Oude Leije ·
          <a href={url('/disclaimer/')}>Disclaimer</a>
        </p>
      </div>
    </footer>

    <script>
      // Kop wordt wit zodra je naar beneden scrolt.
      const header = document.querySelector('.site-header')!;
      const update = () => header.classList.toggle('scrolled', scrollY > 40);
      addEventListener('scroll', update, { passive: true });
      update();
    </script>
  </body>
</html>
